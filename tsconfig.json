{
  "//TR": "Bu dosya starter TypeScript kaynaklarını strict NodeNext kurallarıyla typecheck etmek için compiler ayarlarını tanımlar.",
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "vitest/globals"
    ],
    "noEmit": true
  },
  "include": [
    "core/**/*.ts",
    "models/**/*.ts",
    "apps/**/*.ts",
    "tests/**/*.ts"
  ]
}
