{
  "//TR": "Bu policy child process environmentını explicit allowlist + exact provider değişkenleriyle sınırlar; broad CLAUDE_/CODEX_/ANTHROPIC_/OPENAI_ prefix inheritance yasaktır.",
  "schemaVersion": "2.0.0",
  "alwaysAllow": [
    "PATH",
    "Path",
    "HOME",
    "USERPROFILE",
    "APPDATA",
    "LOCALAPPDATA",
    "TEMP",
    "TMP",
    "SystemRoot",
    "ComSpec",
    "PATHEXT",
    "OS",
    "NUMBER_OF_PROCESSORS",
    "PROCESSOR_ARCHITECTURE"
  ],
  "allowPrefixes": [
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "NO_PROXY",
    "SSL_CERT_"
  ],
  "denyNamePatterns": [
    "PASSWORD",
    "SECRET",
    "TOKEN",
    "KEY",
    "CREDENTIAL"
  ],
  "exceptionPrefixes": [],
  "note": "Common proxy/certificate env prefixleri deterministic/local tooling için allowlisttedir; external model provider child processlerine yalnız providerNetworkEnvAllow içindeki exact adlar aktarılır. Provider credential/config aktarımı exact-name allowlist ile yapılır.",
  "explicitDeny": [
    "NODE_OPTIONS",
    "NPM_CONFIG_USERCONFIG",
    "NPM_CONFIG_PREFIX",
    "GIT_CONFIG_GLOBAL",
    "GIT_CONFIG_SYSTEM",
    "GIT_SSH_COMMAND",
    "BASH_ENV",
    "ENV",
    "PROMPT_COMMAND",
    "NODE_PATH",
    "ELECTRON_RUN_AS_NODE",
    "GIT_CONFIG_COUNT"
  ],
  "providerAllow": {
    "ANTHROPIC": [
      "CLAUDE_CONFIG_DIR"
    ],
    "OPENAI": [
      "CODEX_HOME"
    ]
  },
  "providerPaidApiAllow": {
    "ANTHROPIC": [
      "ANTHROPIC_API_KEY"
    ],
    "OPENAI": [
      "OPENAI_API_KEY"
    ]
  },
  "providerNetworkEnvAllow": {
    "ANTHROPIC": [],
    "OPENAI": []
  }
}
