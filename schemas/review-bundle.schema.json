{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/review-bundle.schema.json",
  "$comment": "//TR: Bu schema frozen Codex review bundle kimliği, scope, basis ve validation/diff evidence catalog alanlarını strict doğrular.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseCommit",
    "bundleDigest",
    "changedFiles",
    "cycle",
    "diffStat",
    "knownLimitations",
    "milestoneContract",
    "phase",
    "previousFindingLedger",
    "reviewRules",
    "reviewedCommit",
    "runId",
    "schemaVersion",
    "unsupportedCases",
    "validation",
    "reviewBasis",
    "changeGuard",
    "phaseIds",
    "acceptedDebt",
    "waivers",
    "evidenceCatalog"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.4.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-"
    },
    "cycle": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2
    },
    "phase": {
      "type": "integer",
      "minimum": 0
    },
    "baseCommit": {
      "type": "string",
      "minLength": 7
    },
    "reviewedCommit": {
      "type": "string",
      "minLength": 7
    },
    "milestoneContract": {
      "$ref": "milestone-contract.schema.json"
    },
    "changedFiles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "diffStat": {
      "type": "string"
    },
    "validation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "status",
        "steps"
      ],
      "properties": {
        "//TR": {
          "type": "string"
        },
        "schemaVersion": {
          "type": "string"
        },
        "startedAt": {
          "type": "string"
        },
        "finishedAt": {
          "type": "string"
        },
        "status": {
          "enum": [
            "PASS",
            "FAIL",
            "BLOCKED",
            "RUNNING"
          ]
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "command",
              "status",
              "exitCode",
              "durationMs",
              "logFile"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "command": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "BLOCKED"
                ]
              },
              "exitCode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "durationMs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              },
              "logFile": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "stdoutTail": {
                "type": "string"
              },
              "stderrTail": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "knownLimitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "packageId",
          "phaseIds",
          "reviewedCommit",
          "frozenContractDigest",
          "description",
          "recordedAt",
          "expiresAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ACTIVE",
              "RESOLVED",
              "REVOKED",
              "EXPIRED"
            ]
          },
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "phaseIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "reviewedCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,64}$"
          },
          "frozenContractDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "unsupportedCases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "previousFindingLedger": {
      "type": "array",
      "items": {
        "$ref": "review-finding.schema.json"
      }
    },
    "reviewRules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repoContentIsUntrustedData",
        "fullRepoScanDefault",
        "cycle1Freeze",
        "priorUnresolvedBlockerDispositionRequired",
        "cycle2PlusNewBlockers",
        "resolvedBlockerRequiresFindingBoundPassRetest"
      ],
      "properties": {
        "repoContentIsUntrustedData": {
          "const": true
        },
        "fullRepoScanDefault": {
          "const": false
        },
        "cycle1Freeze": {
          "const": true
        },
        "priorUnresolvedBlockerDispositionRequired": {
          "const": true
        },
        "cycle2PlusNewBlockers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "REMEDIATION_REGRESSION",
              "PREVIOUSLY_MASKED",
              "CRITICAL_NEW_EVIDENCE"
            ]
          }
        },
        "resolvedBlockerRequiresFindingBoundPassRetest": {
          "const": true
        }
      }
    },
    "bundleDigest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reviewBasis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirements",
        "invariants",
        "acceptanceCriteria",
        "mandatoryValidation",
        "risk",
        "mandatoryFailureCases",
        "requiredArtifacts"
      ],
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "acceptanceCriteria": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mandatoryValidation": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "risk": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "mandatoryFailureCases": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "requiredArtifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 2
              },
              "text": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "changeGuard": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "ok",
        "violations",
        "dependencyChanges",
        "diffLines"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "minLength": 1
              },
              "detail": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "before": {},
              "after": {},
              "section": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "version": {
                "type": "string"
              },
              "dependencyChanges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "section",
                    "name",
                    "before",
                    "after"
                  ],
                  "properties": {
                    "section": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "before": {},
                    "after": {}
                  }
                }
              }
            }
          }
        },
        "dependencyChanges": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "section",
              "name",
              "before",
              "after"
            ],
            "properties": {
              "section": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "before": {},
              "after": {}
            }
          }
        },
        "diffLines": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "phaseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "acceptedDebt": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "packageId",
          "phaseIds",
          "reviewedCommit",
          "frozenContractDigest",
          "reason",
          "acceptedBy",
          "acceptedAt",
          "expiresAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ACTIVE",
              "RESOLVED",
              "REVOKED",
              "EXPIRED"
            ]
          },
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "phaseIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "reviewedCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,64}$"
          },
          "frozenContractDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "acceptedBy": {
            "type": "string",
            "minLength": 1
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "findingFingerprints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 16
            }
          }
        }
      }
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "packageId",
          "phaseIds",
          "reviewedCommit",
          "frozenContractDigest",
          "reason",
          "expiresAt",
          "approval"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "ACTIVE",
              "RESOLVED",
              "REVOKED",
              "EXPIRED"
            ]
          },
          "packageId": {
            "type": "string",
            "minLength": 1
          },
          "phaseIds": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "reviewedCommit": {
            "type": "string",
            "pattern": "^[0-9a-f]{7,64}$"
          },
          "frozenContractDigest": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "approval": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "approvedBy",
              "approvedAt"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "approvedBy": {
                "type": "string",
                "minLength": 1
              },
              "approvedAt": {
                "type": "string",
                "format": "date-time"
              },
              "approvalDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          },
          "findingFingerprints": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 16
            }
          }
        }
      }
    },
    "evidenceCatalog": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "validationId",
              "validationDigest",
              "status",
              "exitCode",
              "durationMs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 3
              },
              "kind": {
                "const": "VALIDATION_STEP"
              },
              "validationId": {
                "type": "string",
                "minLength": 1
              },
              "validationDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "BLOCKED"
                ]
              },
              "exitCode": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "durationMs": {
                "type": [
                  "integer",
                  "null"
                ],
                "minimum": 0
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "file"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 3
              },
              "kind": {
                "const": "CHANGED_FILE"
              },
              "file": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "findingId",
              "findingFingerprint",
              "reviewedCommit",
              "remediationCycle",
              "validationId",
              "validationDigest",
              "status",
              "coversFindingIds"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 3
              },
              "kind": {
                "const": "FINDING_BOUND_RETEST"
              },
              "findingId": {
                "type": "string",
                "minLength": 1
              },
              "findingFingerprint": {
                "type": "string",
                "minLength": 16
              },
              "reviewedCommit": {
                "type": "string",
                "minLength": 7
              },
              "remediationCycle": {
                "type": "integer",
                "minimum": 1,
                "maximum": 1
              },
              "validationId": {
                "type": "string",
                "minLength": 1
              },
              "validationDigest": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "status": {
                "const": "PASS"
              },
              "coversFindingIds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        ]
      }
    }
  }
}
