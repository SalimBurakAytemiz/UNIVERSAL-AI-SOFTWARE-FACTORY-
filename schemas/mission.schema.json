{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "//TR: Bu schema Mission'ın amaç, strict scope, authorization, environment, data classification ve lifecycle alanlarını runtime tipleriyle uyumlu doğrular.",
  "type": "object",
  "required": ["authorization","dataClassification","environment","id","objective","scope","status","type"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "type": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "scope": {
      "type": "object",
      "required": ["targets"],
      "properties": {
        "targets": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "exclusions": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "environment": {"type": "string", "minLength": 1},
    "dataClassification": {"enum": ["PUBLIC","INTERNAL","CONFIDENTIAL","RESTRICTED","PII","FINANCIAL","SECRET"]},
    "authorization": {
      "type": "object",
      "required": ["verified"],
      "properties": {
        "verified": {"type": "boolean"},
        "provenance": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "status": {"enum": ["DRAFT","PREFLIGHT","AUTHORIZED","PLANNED","EXECUTING","VERIFYING","REVIEWING","REMEDIATING","REGRESSION","REPORTING","COMPLETE","BLOCKED","FOUNDER_ATTENTION_REQUIRED"]},
    "stopConditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
