    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "providerId": {
      "type": "string"
    },
    "modelId": {
      "type": "string"
    },
    "provenance": {
      "type": "object"
    },
    "dataPolicy": {
      "type": "object"
    },
    "result": {
      "type": "string"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
