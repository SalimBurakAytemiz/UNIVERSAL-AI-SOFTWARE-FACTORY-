{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/service-identity.schema.json",
  "$comment": "//TR: Bu schema service-identity primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "service-identity",
  "type": "object",
  "required": [
    "authority",
    "createdAt",
    "id",
    "schemaVersion",
    "scope",
    "status",
    "subjectId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "subjectId": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
