{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/dlp-event.schema.json",
  "$comment": "//TR: Bu schema dlp-event primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "dlp-event",
  "type": "object",
  "required": [
    "classification",
    "createdAt",
    "environmentId",
    "evidenceRefs",
    "id",
    "policy",
    "schemaVersion",
    "scope",
    "status",
    "timestamp"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "classification": {
      "type": "string"
    },
    "policy": {
      "type": "object"
    },
    "scope": {
      "type": "object"
    },
    "timestamp": {
      "type": "string"
    },
    "environmentId": {
      "type": "string"
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
