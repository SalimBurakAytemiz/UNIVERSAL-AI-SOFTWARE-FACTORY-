{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/agent-contract.schema.json",
  "$comment": "//TR: Bu schema agent-contract primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "agent-contract",
  "type": "object",
  "required": [
    "agentId",
    "allowedToolIds",
    "capabilities",
    "certificationState",
    "costCeiling",
    "createdAt",
    "customerId",
    "dataPolicy",
    "id",
    "modelPolicy",
    "name",
    "owner",
    "permissions",
    "requiredSkillIds",
    "reviewChainAgentIds",
    "riskCeiling",
    "roleId",
    "schemaVersion",
    "scope",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "customerId": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "owner": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certificationState": {
      "type": "string"
    },
    "agentId": {
      "type": "string",
      "pattern": "^\\d{3}$"
    },
    "roleId": {
      "type": "string",
      "minLength": 1
    },
    "requiredSkillIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "allowedToolIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "modelPolicy": {
      "type": "object"
    },
    "dataPolicy": {
      "type": "object"
    },
    "riskCeiling": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "costCeiling": {
      "type": "number",
      "minimum": 0
    },
    "customerScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missionScope": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewChainAgentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{3}$"
      }
    }
  },
  "additionalProperties": false
}
