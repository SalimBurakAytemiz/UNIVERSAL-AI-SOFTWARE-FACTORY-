{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/competency-evaluation.schema.json",
  "$comment": "//TR: Bu schema competency-evaluation primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "competency-evaluation",
  "type": "object",
  "required": [
    "agentId",
    "axes",
    "createdAt",
    "evidenceRefs",
    "id",
    "result",
    "reviewer",
    "schemaVersion",
    "skillIds",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "agentId": {
      "type": "string",
      "pattern": "^\\d{3}$"
    },
    "skillIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "technologyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "axes": {
      "type": "object",
      "minProperties": 3
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "NOT_EVALUATED"
      ]
    },
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewer": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
