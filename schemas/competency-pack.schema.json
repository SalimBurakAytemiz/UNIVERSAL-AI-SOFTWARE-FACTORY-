{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/competency-pack.schema.json",
  "$comment": "//TR: Bu schema competency-pack primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "competency-pack",
  "type": "object",
  "required": [
    "certificationPolicy",
    "createdAt",
    "domains",
    "id",
    "name",
    "requiredSkillIds",
    "schemaVersion",
    "status",
    "technologyIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "domains": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "requiredSkillIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "technologyIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certificationPolicy": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
