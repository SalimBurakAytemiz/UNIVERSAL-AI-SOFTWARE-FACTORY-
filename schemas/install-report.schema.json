{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/install-report.schema.json",
  "$comment": "//TR: Bu schema one-click installer özetini exact installId, component status+SHA digestleri ve Phase0 binding kimliğiyle doğrular.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "//TR",
    "schemaVersion",
    "generatedAt",
    "installId",
    "components",
    "phase0Final",
    "phase0SourceCommit",
    "phase0SealSignature",
    "digest"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "installId": {
      "type": "string",
      "pattern": "^INSTALL-"
    },
    "components": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "present",
          "file",
          "status",
          "sha256"
        ],
        "properties": {
          "present": {
            "type": "boolean"
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "phase0Final": {
      "enum": [
        "CLEAN",
        "CLEAN_LOCAL_ONLY",
        "BLOCKED",
        "PENDING"
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "phase0SourceCommit": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "phase0SealSignature": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 40
        },
        {
          "type": "null"
        }
      ]
    },
    "//TR": {
      "type": "string",
      "minLength": 1
    }
  }
}
