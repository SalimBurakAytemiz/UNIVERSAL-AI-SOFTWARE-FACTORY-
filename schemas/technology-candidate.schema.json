{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/technology-candidate.schema.json",
  "$comment": "//TR: Bu schema technology-candidate primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "technology-candidate",
  "type": "object",
  "required": [
    "createdAt",
    "detectedFrom",
    "id",
    "missionId",
    "rawName",
    "schemaVersion",
    "sourceRefs",
    "state",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "rawName": {
      "type": "string",
      "minLength": 1
    },
    "normalizedName": {
      "type": [
        "string",
        "null"
      ]
    },
    "state": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "missionId": {
      "type": "string",
      "minLength": 1
    },
    "detectedFrom": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
