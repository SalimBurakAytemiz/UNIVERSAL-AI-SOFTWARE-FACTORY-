{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/data-classification.schema.json",
  "$comment": "//TR: Bu schema data-classification primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "data-classification",
  "type": "object",
  "required": [
    "classification",
    "createdAt",
    "id",
    "policy",
    "schemaVersion",
    "scope",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "classification": {
      "type": "string"
    },
    "policy": {
      "type": "object"
    },
    "scope": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
