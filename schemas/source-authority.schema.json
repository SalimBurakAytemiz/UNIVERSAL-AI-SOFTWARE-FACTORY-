{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/source-authority.schema.json",
  "$comment": "//TR: Bu schema source-authority primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "source-authority",
  "type": "object",
  "required": [
    "allowedForCertification",
    "corroborationRequired",
    "createdAt",
    "id",
    "priority",
    "schemaVersion",
    "sourceClass",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "sourceClass": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "integer",
      "minimum": 1
    },
    "allowedForCertification": {
      "type": "boolean"
    },
    "corroborationRequired": {
      "type": "boolean"
    },
    "locator": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
