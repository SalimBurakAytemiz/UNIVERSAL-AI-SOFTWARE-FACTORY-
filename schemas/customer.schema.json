{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/customer.schema.json",
  "$comment": "//TR: Bu schema customer primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "customer",
  "type": "object",
  "required": [
    "createdAt",
    "customerId",
    "id",
    "owner",
    "schemaVersion",
    "scope",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "customerId": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "owner": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
