{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/agent-skill-profile.schema.json",
  "$comment": "//TR: Bu schema agent-skill-profile primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "agent-skill-profile",
  "type": "object",
  "required": [
    "agentId",
    "capabilities",
    "certificationState",
    "createdAt",
    "id",
    "name",
    "requiredSkillIds",
    "schemaVersion",
    "status",
    "technologyDepth"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "name": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certificationState": {
      "type": "string"
    },
    "agentId": {
      "type": "string",
      "pattern": "^\\d{3}$"
    },
    "requiredSkillIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "technologyDepth": {
      "type": "array",
      "items": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false
}
