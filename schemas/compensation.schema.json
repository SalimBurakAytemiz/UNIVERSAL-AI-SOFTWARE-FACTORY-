{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/compensation.schema.json",
  "$comment": "//TR: Bu schema compensation primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "compensation",
  "type": "object",
  "required": [
    "createdAt",
    "id",
    "missionId",
    "objective",
    "riskLevel",
    "schemaVersion",
    "scope",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "missionId": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "riskLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    }
  },
  "additionalProperties": false
}
