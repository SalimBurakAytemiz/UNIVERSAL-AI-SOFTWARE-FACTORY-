{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/phase0-acceptance.schema.json",
  "$comment": "//TR: Bu schema autonomous full build başlamadan önce artifact/env/git/provider/trust/logging/review/scheduler/smoke kontrollerinin PASS/BLOCKED/PENDING durumunu tek Phase-0 raporunda zorunlu kılar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "checks",
    "final",
    "generatedAt",
    "schemaVersion"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "object",
      "minProperties": 10,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "status",
          "detail"
        ],
        "properties": {
          "status": {
            "enum": [
              "PASS",
              "BLOCKED",
              "PENDING",
              "WARN",
              "NOT_APPLICABLE"
            ]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "final": {
      "enum": [
        "CLEAN",
        "CLEAN_LOCAL_ONLY",
        "BLOCKED",
        "PENDING"
      ]
    }
  }
}
