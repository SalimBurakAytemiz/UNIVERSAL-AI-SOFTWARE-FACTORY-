{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/run-manifest.schema.json",
  "$comment": "//TR: Bu schema autonomous supervisor invocation-level run manifest producer reality v1.1.0 alanlarını strict doğrular.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "//TR",
    "schemaVersion",
    "runId",
    "startedAt",
    "baseCommit",
    "mode",
    "executionUnit",
    "builder",
    "reviewer",
    "remoteConfigured",
    "remoteUrl",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "baseCommit": {
      "type": "string",
      "minLength": 7
    },
    "mode": {
      "type": "string",
      "minLength": 1
    },
    "executionUnit": {
      "type": "string",
      "minLength": 1
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "modelId"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "modelId"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "modelId": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "remoteConfigured": {
      "type": "boolean"
    },
    "remoteUrl": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "const": "RUNNING"
    },
    "//TR": {
      "type": "string",
      "minLength": 1
    }
  }
}
