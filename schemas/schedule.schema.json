{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/schedule.schema.json",
  "$comment": "//TR: Bu schema schedule primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "schedule",
  "type": "object",
  "required": [
    "amount",
    "createdAt",
    "currency",
    "id",
    "policy",
    "schemaVersion",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string"
    },
    "policy": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
