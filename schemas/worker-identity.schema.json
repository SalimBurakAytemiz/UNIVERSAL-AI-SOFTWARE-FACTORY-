{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/worker-identity.schema.json",
  "$comment": "//TR: Bu schema worker-identity primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "worker-identity",
  "type": "object",
  "required": [
    "authority",
    "capabilities",
    "certificationState",
    "createdAt",
    "id",
    "name",
    "schemaVersion",
    "scope",
    "status",
    "subjectId"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "subjectId": {
      "type": "string"
    },
    "scope": {
      "type": "object"
    },
    "authority": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name": {
      "type": "string"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "certificationState": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
