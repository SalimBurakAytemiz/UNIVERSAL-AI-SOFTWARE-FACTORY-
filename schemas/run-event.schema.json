{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/run-event.schema.json",
  "$comment": "//TR: Bu schema hash-chain bağlı runtime event producer reality v1.1.0 alanlarını strict doğrular.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "sequence",
    "timestamp",
    "phase",
    "milestoneId",
    "actor",
    "stage",
    "event",
    "severity",
    "durationMs",
    "exitCode",
    "details",
    "artifactRefs",
    "previousEventHash",
    "eventHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "runId": {
      "type": "string",
      "pattern": "^RUN-"
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "phase": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "milestoneId": {
      "type": [
        "string",
        "null"
      ]
    },
    "actor": {
      "type": [
        "string",
        "null"
      ]
    },
    "stage": {
      "type": "string",
      "minLength": 1
    },
    "event": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "enum": [
        "DEBUG",
        "INFO",
        "WARN",
        "ERROR",
        "CRITICAL"
      ]
    },
    "durationMs": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "exitCode": {
      "type": [
        "integer",
        "null"
      ]
    },
    "details": {
      "type": "object"
    },
    "artifactRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "previousEventHash": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "eventHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
