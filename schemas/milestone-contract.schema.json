{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/milestone-contract.schema.json",
  "$comment": "//TR: Bu schema build başlamadan önce objective/acceptance/scope/risk/evidence/review sınırlarını frozen digest ile sabitler ve builder/reviewer moving-scope problemini azaltır.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "acceptanceCriteria",
    "allowPaidApi",
    "allowProduction",
    "allowRisk5",
    "allowedPathPrefixes",
    "digest",
    "frozenAt",
    "id",
    "invariants",
    "mandatoryEvidence",
    "mandatoryValidation",
    "objective",
    "phase",
    "protectedPaths",
    "requirements",
    "reviewProfile",
    "riskLevel",
    "schemaVersion",
    "title",
    "unsupportedCases",
    "allowDependencyChanges",
    "phaseIds",
    "mandatoryFailureCases",
    "requiredArtifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "integer",
      "minimum": 0
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "objective": {
      "type": "string",
      "minLength": 3
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string"
      }
    },
    "allowedPathPrefixes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "protectedPaths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "mandatoryValidation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "mandatoryEvidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "riskLevel": {
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "allowPaidApi": {
      "type": "boolean"
    },
    "allowProduction": {
      "type": "boolean"
    },
    "allowRisk5": {
      "type": "boolean"
    },
    "unsupportedCases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "reviewProfile": {
      "enum": [
        "STANDARD",
        "TRUST_CRITICAL",
        "SECURITY_CRITICAL",
        "RELEASE_CRITICAL"
      ]
    },
    "maxFilesChanged": {
      "type": "integer",
      "minimum": 1
    },
    "allowExistingTestAssertionReduction": {
      "type": "boolean"
    },
    "frozenAt": {
      "type": "string",
      "format": "date-time"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "allowDependencyChanges": {
      "type": "boolean"
    },
    "phaseIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "mandatoryFailureCases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "requiredArtifacts": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
