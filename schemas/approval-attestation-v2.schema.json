{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$comment": "//TR: Approval'u trusted actor/action/target digest ve expiry/revocation ile non-repudiable bağlama için minimum strict runtime sözleşmesini tanımlar.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "actionDigest",
    "approverIdentityId",
    "expiresAt",
    "grantedAt",
    "id",
    "targetDigest"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "approverIdentityId": {"type": "string", "minLength": 1},
    "actionDigest": {"type": "string", "minLength": 16},
    "targetDigest": {"type": "string", "minLength": 16},
    "grantedAt": {"type": "string", "format": "date-time"},
    "expiresAt": {"type": "string", "format": "date-time"},
    "revokedAt": {"type": "string", "format": "date-time"}
  }
}
