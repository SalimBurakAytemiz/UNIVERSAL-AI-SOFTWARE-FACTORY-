{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://uasco.local/schemas/playbook.schema.json",
  "$comment": "//TR: Bu schema playbook primitive/contract kaydının canonical minimum yapısını doğrulamak için final architecture closure kapsamında oluşturulmuştur.",
  "title": "playbook",
  "type": "object",
  "required": [
    "createdAt",
    "evidenceRequirements",
    "id",
    "name",
    "qualityGates",
    "schemaVersion",
    "status",
    "steps"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredSkillIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "requiredToolIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "qualityGates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidenceRequirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
