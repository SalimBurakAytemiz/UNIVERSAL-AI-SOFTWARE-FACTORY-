{
  "//TR": "Founder departman listesi (UASCO_LIVE_STATUS_REPORT.md §B, 2026-10-26 sırası) ve sıralı sınıflandırma kuralları. İlk eşleşen kural kazanır; hiçbir kural eşleşmezse UNASSIGNED. Lane departman değildir; defaultLane yalnız PR dalı öneki yoksa kullanılır.",
  "schemaVersion": "1.0.0",
  "departments": [
    { "id": "DESKTOP_UX", "label": "Lane A: Desktop/UX", "defaultLane": "A" },
    { "id": "BACKEND_API", "label": "Lane B: Backend/API", "defaultLane": "B" },
    { "id": "AI_AGENT_WORKFLOW", "label": "Lane C: AI agent/workflow", "defaultLane": "C" },
    { "id": "COORDINATOR_GOVERNANCE", "label": "Koordinatör / Master V2", "defaultLane": "COORD" },
    { "id": "QA_TEST", "label": "QA / test otomasyonu", "defaultLane": null },
    { "id": "SECURITY", "label": "Security", "defaultLane": null },
    { "id": "DEVOPS_CICD", "label": "DevOps / CI/CD", "defaultLane": null },
    { "id": "MOBILE", "label": "Mobile", "defaultLane": null },
    { "id": "DATA_DATABASE", "label": "Database / Data", "defaultLane": null },
    { "id": "AI_ML", "label": "AI/ML", "defaultLane": null },
    { "id": "GAMING_STUDIO", "label": "Gaming Studio", "defaultLane": null },
    { "id": "UNASSIGNED", "label": "Diğer (eşlenmeyen)", "defaultLane": null }
  ],
  "fallback": "UNASSIGNED",
  "rules": [
    { "id": "R01", "note": "UI screens not in any WS-SC member list", "when": { "idPrefix": ["UI-"], "notInWorkspace": true }, "department": "MOBILE" },
    { "id": "R02", "when": { "idPrefix": ["UI-", "WS-SC-", "UX-DEC-"] }, "department": "DESKTOP_UX" },
    { "id": "R03", "when": { "idPrefix": ["G-EP-"] }, "department": "BACKEND_API" },
    { "id": "R04", "when": { "idPrefix": ["I-DP-"] }, "department": "DATA_DATABASE" },
    { "id": "R05", "when": { "idPrefix": ["F-LAB-"], "titleRegex": "Game" }, "department": "GAMING_STUDIO" },
    { "id": "R06", "when": { "idPrefix": ["F-LAB-"], "titleRegex": "Mobile" }, "department": "MOBILE" },
    { "id": "R07", "when": { "idPrefix": ["F-LAB-"], "titleRegex": "Security|Identity" }, "department": "SECURITY" },
    { "id": "R08", "when": { "idPrefix": ["F-LAB-"], "titleRegex": "CI/CD|Release|Cloud" }, "department": "DEVOPS_CICD" },
    { "id": "R09", "when": { "idPrefix": ["F-LAB-"], "titleRegex": "Data, Database" }, "department": "DATA_DATABASE" },
    { "id": "R10", "when": { "idPrefix": ["F-LAB-"], "titleRegex": "AI, ML" }, "department": "AI_ML" },
    { "id": "R11", "when": { "idPrefix": ["F-LAB-"] }, "department": "QA_TEST" },
    { "id": "R12", "when": { "idPrefix": ["PH-"], "titleRegex": "Game|Unity" }, "department": "GAMING_STUDIO" },
    { "id": "R13", "when": { "idPrefix": ["PH-"], "titleRegex": "Mobile" }, "department": "MOBILE" },
    { "id": "R13b-DESKTOP", "note": "STUDIOS by title: PH-047 Design, PH-048 Web, PH-052 Desktop", "when": { "idIn": ["PH-047", "PH-048", "PH-052"] }, "department": "DESKTOP_UX" },
    { "id": "R13b-BACKEND", "note": "PH-049 Backend/API Studio", "when": { "idIn": ["PH-049"] }, "department": "BACKEND_API" },
    { "id": "R13b-DATA", "note": "PH-050 Data/Database Studio", "when": { "idIn": ["PH-050"] }, "department": "DATA_DATABASE" },
    { "id": "R13b-AI", "note": "PH-053 AI/Data Studio", "when": { "idIn": ["PH-053"] }, "department": "AI_ML" },
    { "id": "R14", "note": "PH by contract domain; unmapped domains fall through", "when": { "idPrefix": ["PH-"] }, "mapField": "domain",
      "map": { "TRUST_CORE": "COORDINATOR_GOVERNANCE", "ORGANIZATION_COMPETENCY": "AI_AGENT_WORKFLOW", "EXECUTION": "AI_AGENT_WORKFLOW", "MISSION_INTELLIGENCE_AI": "AI_ML", "RESOURCES_EVIDENCE": "DATA_DATABASE", "QUALITY": "QA_TEST", "ACCEPTANCE": "QA_TEST", "SECURITY": "SECURITY", "PERFORMANCE_SRE_RELEASE": "DEVOPS_CICD", "FINAL_RELEASE": "DEVOPS_CICD" } },
    { "id": "R15-SEC", "when": { "idPrefix": ["PT-"], "areaRegex": "^qa-security/|^platform/security" }, "department": "SECURITY" },
    { "id": "R15-QA", "when": { "idPrefix": ["PT-"], "areaRegex": "^qa/|^platform/test-|^platform/E2E" }, "department": "QA_TEST" },
    { "id": "R15-DEVOPS", "when": { "idPrefix": ["PT-"], "areaRegex": "^release/|^platform/CI|^platform/merge-queue|^platform/cloud-env|^maintenance" }, "department": "DEVOPS_CICD" },
    { "id": "R15-GOV", "when": { "idPrefix": ["PT-"], "areaRegex": "^governance/|^automation/" }, "department": "COORDINATOR_GOVERNANCE" },
    { "id": "R15-BACKEND", "when": { "idPrefix": ["PT-"], "areaRegex": "^product-backend/" }, "department": "BACKEND_API" },
    { "id": "R15-UI", "when": { "idPrefix": ["PT-"], "areaRegex": "^product-ui/" }, "department": "DESKTOP_UX" },
    { "id": "R16-LANE-A", "when": { "idPrefix": ["LANE-A-"] }, "department": "DESKTOP_UX" },
    { "id": "R16-LANE-B", "when": { "idPrefix": ["LANE-B-"] }, "department": "BACKEND_API" },
    { "id": "R16-LANE-C", "when": { "idPrefix": ["LANE-C-"] }, "department": "AI_AGENT_WORKFLOW" },
    { "id": "R16-COORD", "when": { "idPrefix": ["COORD-"] }, "department": "COORDINATOR_GOVERNANCE" },
    { "id": "R16-WAVE0", "when": { "idPrefix": ["C-"], "origin": ["WAVE0"] }, "department": "AI_AGENT_WORKFLOW" },
    { "id": "R16-MOB", "when": { "idPrefix": ["MOB-"] }, "department": "MOBILE" },
    { "id": "R16-SEC", "when": { "idPrefix": ["SEC-"] }, "department": "SECURITY" }
  ]
}
