   "source": "// Reproduce: main.mjs apiPost sanitizes 2xx bodies with scrubText, which rewrites absolute paths to \"[path]\";\n// uasco:export-delivery then feeds the sanitized body.path to deliveryExportCheck -> realpath fails.\nimport fs from \"node:fs\";\nimport path from \"node:path\";\nimport os from \"node:os\";\nimport crypto from \"node:crypto\";\nconst main = fs.readFileSync(process.argv[2], \"utf8\");\nconst scrub = /(function scrubText[\\s\\S]*?)async function apiPost/.exec(main)[1];\nconst exp = /(const DELIVERY_RUN_ID_RE[\\s\\S]*?)\\/\\/ M1A-C2-END/.exec(main)[1];\nconst {sanitizePostBody, deliveryExportCheck} = new Function(\"token\", `${scrub}\\n${exp}\\nreturn {sanitizePostBody, deliveryExportCheck};`)(\"tok\");\nconst root = fs.mkdtempSync(path.join(os.tmpdir(), \"uasco-scrub-\"));\nconst runId = \"run_\" + \"a\".repeat(24), bytes = Buffer.from(\"zipbytes\"), hash = crypto.createHash(\"sha256\").update(bytes).digest(\"hex\");\nconst deliveries = path.join(root, \"deliveries\"); fs.mkdirSync(path.join(deliveries, runId), {recursive: true});\nconst file = path.join(deliveries, runId, `${hash}.zip`); fs.writeFileSync(file, bytes);\nconst body = {artifact: {runId, exportArtifactHash: hash, artifactPath: `deliveries/${runId}/${hash}.zip`}, sha256: hash, size: bytes.length, fileState: \"VERIFIED\", path: file};\nconst raw = deliveryExportCheck(body, runId, deliveries, fs, path, crypto);\nconst sanitized = sanitizePostBody(200, body);\nconst viaBridge = deliveryExportCheck(sanitized, runId, deliveries, fs, path, crypto);\nconst winSample = sanitizePostBody(200, {path: \"C:\\\\Users\\\\salim\\\\AppData\\\\Roaming\\\\UASCO\\\\workos\\\\deliveries\\\\x.zip\"}).path;\nconsole.log(JSON.stringify({rawBodyCheck: raw.ok ? \"OK\" : raw.reason, sanitizedPath: sanitized.path, bridgeCheck: viaBridge.ok ? \"OK\" : viaBridge.reason, windowsPathAfterScrub: winSample}));\nfs.rmSync(root, {recursive: true, force: true});\n",
   "stdout": "{\"rawBodyCheck\":\"OK\",\"sanitizedPath\":\"[path]\",\"bridgeCheck\":\"DELIVERY_ARTIFACT_MISSING\",\"windowsPathAfterScrub\":\"[path]\"}",
