+const memoryFail=(reply:any,e:unknown)=>{if(!(e instanceof ProjectMemoryError))throw e;const st=e.code==="MEMORY_NOT_FOUND"?404:e.code==="MEMORY_TAMPERED"||e.code==="MEMORY_READ_ONLY"||e.code==="MEMORY_BUSY"?409:400;return reply.code(st).send({error:e.code})};
